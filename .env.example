# Server Port
PORT=5000

# MongoDB Database Connection String (Local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/fixnear

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here

# Allowed Client Origin(s) for CORS (comma-separated if multiple)
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173

# Node Environment ('development' or 'production')
NODE_ENV=development

# Cloudinary Storage Configuration (Optional: required for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Frontend Local API & Socket Configuration
# (Set to http://localhost:5000 for local development)
VITE_API_URL=http://localhost:5000
VITE_SOCKET_URL=http://localhost:5000
